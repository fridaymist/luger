{
  "name": "luger",
  "productName": "Luger",
  "version": "0.9.2",
  "description": "Macro hub, launcher and automation tools for Roblox games that allow macros.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Luger",
    "email": "306194643+fridaymist@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:offline": "LUGER_OFFLINE=1 electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:py": "python3 -m pytest python/tests -q",
    "fetch-python": "node scripts/fetch-python.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "jose": "5.9.6"
  },
  "devDependencies": {
